AUTODEV_ENV=production
AUTODEV_HOST=0.0.0.0
AUTODEV_PORT=8765
PUBLIC_BASE_URL=https://auto.yangtaoer.com.cn
AUTODEV_ALLOWED_HOSTS=auto.yangtaoer.com.cn,web,localhost,127.0.0.1
AUTODEV_SECURE_COOKIES=1
AUTODEV_DATA_DIR=/app/data
AUTODEV_WORKER_ENABLED=0
AUTODEV_SEED_DEMO=0
AUTODEV_MAX_ARTIFACT_MB=200

# 用于申请 Let's Encrypt 证书到期提醒。
CADDY_EMAIL=replace-with-your-email@example.com

# 邮件由云端发送。留空时生成可下载的 HTML 邮件预览。
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_FROM=autodev@yangtaoer.com.cn
SMTP_FROM_NAME=AutoDev 全自助研发交付
SMTP_STARTTLS=1
