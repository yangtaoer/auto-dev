AUTODEV_ENV=production
AUTODEV_HOST=0.0.0.0
AUTODEV_PORT=8765
PUBLIC_BASE_URL=https://auto.yangtaoer.com.cn
AUTODEV_ALLOWED_HOSTS=auto.yangtaoer.com.cn,localhost,127.0.0.1
AUTODEV_SECURE_COOKIES=1
AUTODEV_DATA_DIR=/app/data
AUTODEV_WORKER_ENABLED=0
AUTODEV_SEED_DEMO=0
AUTODEV_MAX_ARTIFACT_MB=200

# Docker 在 121.4.77.6 上发布的监听地址。
# 如果两台服务器有互通的私网地址，建议改成该私网 IP；否则保持 0.0.0.0，并用安全组严格限制来源。
AUTODEV_BIND_ADDRESS=0.0.0.0
AUTODEV_BACKEND_PORT=28765

# 163 邮箱交付配置。
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_PROTOCOL=smtps
SMTP_USERNAME=yangtaoere@163.com
SMTP_FROM=yangtaoere@163.com
SMTP_FROM_NAME=AutoDev · 自主研发交付
SMTP_PASSWORD=replace-with-163-authorization-code
SMTP_STARTTLS=0
