# 仅用于本机单体演示/开发。正式部署请使用 deploy/cloud/.env.production。
AUTODEV_ENV=development
AUTODEV_HOST=127.0.0.1
AUTODEV_PORT=8765
PUBLIC_BASE_URL=http://127.0.0.1:8765
AUTODEV_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
AUTODEV_SECURE_COOKIES=0
AUTODEV_SECRET_KEY=please-change-this-to-a-long-random-value
AUTODEV_DATA_DIR=./data
AUTODEV_WORKER_ENABLED=1
AUTODEV_SEED_DEMO=1
AUTODEV_POLL_SECONDS=30
AUTODEV_MAX_ARTIFACT_MB=200

BOOTSTRAP_ADMIN_PASSWORD=admin123
BOOTSTRAP_PM_PASSWORD=pm123

AUTODEV_RUNNER_ID=yangtao-pc
AUTODEV_RUNNER_TOKEN=replace-with-a-random-token

TFS_PAT=
TFS_REVIEWER_PAT=
TFS_REVIEWER_ID=
TFS_USER_ALIAS=autodev

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=autodev@example.com
SMTP_STARTTLS=1

# 默认复用本机已有 Codex 登录态。
CODEX_MODEL=
CODEX_API_KEY=
