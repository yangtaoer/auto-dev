AUTODEV_CLOUD_URL=https://auto.yangtaoer.com.cn
AUTODEV_RUNNER_ID=yangtao-pc
AUTODEV_RUNNER_TOKEN_FILE=./local-runner/secrets/runner-token.txt
AUTODEV_DATA_DIR=./data/runner
AUTODEV_POLL_SECONDS=30
AUTODEV_MAX_ARTIFACT_MB=200

# 阿里云 OSS：Runner 将交付物直传 OSS，云端与邮件保存预签名下载地址。
ALIYUN_ACCESS_KEY_ID_FILE=./local-runner/secrets/aliyun-access-key-id.txt
ALIYUN_ACCESS_KEY_SECRET_FILE=./local-runner/secrets/aliyun-access-key-secret.txt
ALIYUN_OSS_REGION=cn-chengdu
ALIYUN_OSS_ENDPOINT=https://oss-cn-chengdu.aliyuncs.com
ALIYUN_OSS_BUCKET=auto-dev-oss
ALIYUN_OSS_PREFIX=autodev
ALIYUN_OSS_URL_EXPIRE_SECONDS=259200
ALIYUN_OSS_RETENTION_DAYS=3
ALIYUN_OSS_CLEANUP_INTERVAL_HOURS=72

# TFS 凭据仅保存在本机。建议使用专用服务账号和最小权限 PAT。
TFS_PAT_FILE=./local-runner/secrets/tfs-pat.txt
TFS_REVIEWER_PAT_FILE=./local-runner/secrets/tfs-reviewer-pat.txt
TFS_REVIEWER_ID=
TFS_USER_ALIAS=autodev

# 默认复用这台电脑已有的 Codex/ChatGPT 登录态，一般无需 API key。
CODEX_MODEL=
CODEX_API_KEY_FILE=./local-runner/secrets/codex-api-key.txt

AUTODEV_GIT_NAME=AutoDev Codex
AUTODEV_GIT_EMAIL=autodev@localhost
